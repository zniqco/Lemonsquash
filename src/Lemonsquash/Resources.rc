#include <windows.h>
#include "Resource.h"
#include "Version.h"

IDI_APP ICON "Assets/Icon.ico"
IDR_UPDATE_CERTIFICATE RCDATA "Assets/Lemonsquash.cer"
IDR_LOGO RCDATA "Assets/Logo.png"
IDR_CALCULATOR RCDATA "Assets/Calculator.png"
IDR_GOOGLE RCDATA "Assets/Google.png"
IDR_SETTINGS RCDATA "Assets/Setting.png"
IDR_TERMINAL RCDATA "Assets/Terminal.png"
1 RT_MANIFEST "App.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION LEMONSQUASH_VERSION_NUMBERS
    PRODUCTVERSION LEMONSQUASH_VERSION_NUMBERS
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "zniq.co\0"
            VALUE "FileDescription", "Lemonsquash\0"
            VALUE "FileVersion", LEMONSQUASH_VERSION_FILE_STRING "\0"
            VALUE "InternalName", "Lemonsquash\0"
            VALUE "OriginalFilename", "Lemonsquash.exe\0"
            VALUE "ProductName", "Lemonsquash\0"
            VALUE "ProductVersion", LEMONSQUASH_VERSION_STRING "\0"
            VALUE "SpecialBuild", LEMONSQUASH_VERSION_POSTFIX "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
